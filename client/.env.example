# ---------------------------------------------------------------------------
# Client configuration
#
# Anything prefixed VITE_ is INLINED INTO THE BUNDLE and readable by anyone who
# opens DevTools. Never put an upstream API key here — those belong in
# server/.env. See PROJECT_PLAN.md §1.2.
# ---------------------------------------------------------------------------

# Deployed backend for HTTP requests and WebSocket price updates.
# Set blank to use the local Vite proxy instead.
VITE_API_URL=https://aminfinance-backend.onrender.com

# Must match AUTH_SECRET in server/.env when that is set. This gates our own
# proxy — it is not a credential for any upstream provider, so its exposure in
# the bundle costs nothing beyond access to a server you already control.
VITE_API_KEY=

# ---------------------------------------------------------------------------
# Supabase — cloud persistence (Postgres + auth)
#
# The publishable key is meant to ship in the bundle. What protects the data is
# row-level security: every table's policy matches `auth.uid()` against the
# row's `user_id`, so this key alone reads nothing. Never put the service_role
# key here — that one bypasses RLS entirely.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
