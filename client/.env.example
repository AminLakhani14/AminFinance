# ---------------------------------------------------------------------------
# Client configuration
#
# Anything prefixed VITE_ is INLINED INTO THE BUNDLE and readable by anyone who
# opens DevTools. Never put an upstream API key here — those belong in
# server/.env. See PROJECT_PLAN.md §1.2.
# ---------------------------------------------------------------------------

# Leave blank in development. Vite proxies /api and /ws to the server, so the
# browser sees a single origin and issues no CORS preflight.
# Set only when the server is deployed to a different host.
VITE_API_URL=

# Must match AUTH_SECRET in server/.env when that is set. This gates our own
# proxy — it is not a credential for any upstream provider, so its exposure in
# the bundle costs nothing beyond access to a server you already control.
VITE_API_KEY=
