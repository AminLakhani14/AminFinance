# Environment for the web frontend bundled into the Android app.
# Copy to mobile/web/.env and fill in. That file is gitignored: these values
# end up inside the APK, but they should not end up in the repository.

# The deployed backend the app talks to.
VITE_API_URL=https://aminfinance-backend.onrender.com

# Same value as AUTH_SECRET on the backend (Render → Environment).
VITE_API_KEY=

# Supabase project, for sign-in and cloud sync. Same values as client/.env.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
