# ---------------------------------------------------------------------------
# AminFinance server configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way —
# every key below is a live credential. Nothing here is ever sent to the
# browser; see PROJECT_PLAN.md §1.2 and §4.4.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# Bind address. Keep 127.0.0.1 unless you have deliberately secured this host —
# an internet-reachable proxy holding these keys lets anyone drain your
# Anthropic credits and read your Binance balances.
HOST=127.0.0.1

# Origin allowed to call the API (the Vite dev server).
# Comma-separate for multiple.
CORS_ORIGIN=http://localhost:5173

# Shared secret required on every /api/* request via the x-aminfinance-key
# header. Leave blank ONLY while bound to 127.0.0.1 — the server refuses to
# start without it on any other host. Generate one with:
#   node -e "console.log(crypto.randomUUID())"
AUTH_SECRET=329690086bbc37b327f8e223cc0f6f74

# ---------------------------------------------------------------------------
# Market data providers — all free tiers. See PROJECT_PLAN.md §9.
# Missing keys degrade individual routes; they do not stop the server.
# ---------------------------------------------------------------------------

# finnhub.io/register — stock quotes, company profile, market cap, news
FINNHUB_API_KEY=

# alphavantage.co/support/#api-key — dividends, fundamentals, news sentiment
# 25 requests/day. The cache in §4.2 exists specifically for this limit.
ALPHAVANTAGE_API_KEY=

# coingecko.com -> Developer Dashboard -> Add New Key — coin metadata, logos
COINGECKO_API_KEY=

# twelvedata.com — historical OHLC for stock charts
TWELVEDATA_API_KEY=

# ---------------------------------------------------------------------------
# Binance — account sync (Phase 3)
#
# Create at Binance -> API Management with "Enable Reading" ONLY.
# Do NOT enable trading or withdrawals, and DO set an IP whitelist.
# With a read-only key, a full compromise of this server exposes your
# balances but never your funds.
#
# Public market data (prices, candles) needs no key — leave blank to run
# everything except account sync.
# ---------------------------------------------------------------------------
BINANCE_API_KEY=E4f9qwa1daD5wryno8IS2A4buiw9brUtyVOONuNgGXAUJNEMXFvkrniPqCck53DB
BINANCE_API_SECRET=KsAaKVBg0SOycTlrtdVJfX8BTO8c4Ho9bysDEwwblAcOKqqYA4fU95cIQGBIoF7P

# ---------------------------------------------------------------------------
# AI insights (Phase 5) — any OpenAI-compatible chat-completions endpoint.
#
# Works with a local Ollama / LM Studio / vLLM box or the OpenAI API itself;
# only the three values below change. The server appends /chat/completions, so
# the base URL must include the /v1 suffix.
#
# Gemini via its OpenAI-compatibility layer (key from aistudio.google.com):
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_API_KEY=<your Gemini key>
#   OPENAI_MODEL=gemini-3.6-flash
#
# Local Ollama example (no real key needed — Ollama ignores the bearer token):
#   OPENAI_BASE_URL=http://192.168.1.50:11434/v1
#   OPENAI_API_KEY=ollama-local
#   OPENAI_MODEL=qwen3.5:4b
#
# Small local models often ignore response_format and return JSON under field
# names of their own — the server validates every reply and rejects those, so
# prefer an endpoint that actually enforces structured outputs.
#
# Leave OPENAI_BASE_URL blank to run everything except AI insights.
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Sent as `reasoning_effort`, and only when non-empty.
#
# Defaults to 'none' (see config.ts) to stop a local reasoning model spending
# the whole token budget thinking. Gemini rejects 'none' with a 400
# INVALID_ARGUMENT, so leave this EMPTY for Gemini — 'low' also works.
AI_REASONING_EFFORT=

# A small local model on CPU generates at a few tokens/second, so a full
# insight can take many minutes; a hosted model answers in seconds. 600000 suits
# local, 120000 is ample for Gemini. Raise it if you see upstream_timeout;
# lower AI_MAX_TOKENS to make each answer finish sooner.
AI_TIMEOUT_MS=600000
AI_MAX_TOKENS=4000
