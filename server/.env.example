# ---------------------------------------------------------------------------
# AminFinance server configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way —
# every key below is a live credential. Nothing here is ever sent to the
# browser; see PROJECT_PLAN.md §1.2 and §4.4.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# Bind address. Keep 127.0.0.1 unless you have deliberately secured this host —
# an internet-reachable proxy holding these keys lets anyone drain your
# Anthropic credits and read your Binance balances.
HOST=127.0.0.1

# Origin allowed to call the API (the Vite dev server).
# Comma-separate for multiple.
CORS_ORIGIN=http://localhost:5173

# Shared secret required on every /api/* request via the x-aminfinance-key
# header. Leave blank ONLY while bound to 127.0.0.1 — the server refuses to
# start without it on any other host. Generate one with:
#   node -e "console.log(crypto.randomUUID())"
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Market data providers — all free tiers. See PROJECT_PLAN.md §9.
# Missing keys degrade individual routes; they do not stop the server.
# ---------------------------------------------------------------------------

# finnhub.io/register — stock quotes, company profile, market cap, news
FINNHUB_API_KEY=

# alphavantage.co/support/#api-key — dividends, fundamentals, news sentiment
# 25 requests/day. The cache in §4.2 exists specifically for this limit.
ALPHAVANTAGE_API_KEY=

# coingecko.com -> Developer Dashboard -> Add New Key — coin metadata, logos
COINGECKO_API_KEY=

# twelvedata.com — historical OHLC for stock charts
TWELVEDATA_API_KEY=

# ---------------------------------------------------------------------------
# Binance — account sync (Phase 3)
#
# Create at Binance -> API Management with "Enable Reading" ONLY.
# Do NOT enable trading or withdrawals, and DO set an IP whitelist.
# With a read-only key, a full compromise of this server exposes your
# balances but never your funds.
#
# Public market data (prices, candles) needs no key — leave blank to run
# everything except account sync.
# ---------------------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---------------------------------------------------------------------------
# Anthropic — AI insights (Phase 5)
# console.anthropic.com
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
